# Base URL for the llama-swap proxy endpoint
# This single endpoint is used for:
# - DeepSeek-OCR model calls
# - Querying currently loaded models (/running)
# - Checking model capabilities (/upstream/{model}/props)
# - Fallback OCR using current multimodal model
DEEPSEEK_OCR_BASE_URL="http://your-endpoint:8080/v1"

# VRAM threshold in GB for DeepSeek-OCR (default: 17)
# If free VRAM is below this threshold, the system will attempt to use
# the currently loaded multimodal model instead
PDF_OCR_VRAM_THRESHOLD_GB="17"
